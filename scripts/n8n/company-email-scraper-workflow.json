{
  "name": "SalesPro - Company Email Scraper & Cross-Referencer",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "1a0b2c3d-0001-4000-8000-000000000001",
      "name": "Hourly Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {},
      "id": "1a0b2c3d-0002-4000-8000-000000000002",
      "name": "Manual Trigger (Test Now)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        200,
        480
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SALESPRO_BASE_URL || 'http://localhost:9006' }}/api/cron/scrape-company-emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.CRON_SECRET || 'your_cron_secret' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"limit\": 50,\n  \"offset\": 0,\n  \"only_unscraped\": true,\n  \"concurrency\": 15,\n  \"timeout_ms\": 5000\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "1a0b2c3d-0003-4000-8000-000000000003",
      "name": "1. Scrape Company Emails",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SALESPRO_BASE_URL || 'http://localhost:9006' }}/api/cron/cross-reference-external-emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.CRON_SECRET || 'your_cron_secret' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"limit\": 100,\n  \"offset\": 0,\n  \"auto_paginate\": true\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "1a0b2c3d-0004-4000-8000-000000000004",
      "name": "2. Cross-Reference External Emails",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const scrapeRes = $('1. Scrape Company Emails').first().json;\nconst crossRefRes = $input.first().json;\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    scrape_status: scrapeRes.success ? 'SUCCESS' : 'FAILED',\n    companies_scraped: scrapeRes.total_processed || scrapeRes.total_targets || 0,\n    emails_found: scrapeRes.emails_found || 0,\n    cross_reference_status: crossRefRes.success ? 'SUCCESS' : 'FAILED',\n    external_evaluated: crossRefRes.total_external_evaluated || 0,\n    external_companies_matched: crossRefRes.companies_matched || 0,\n    new_emails_linked_to_companies: crossRefRes.emails_linked || 0,\n    cross_reference_matches: crossRefRes.matches || []\n  }\n}];"
      },
      "id": "1a0b2c3d-0005-4000-8000-000000000005",
      "name": "Format Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        380
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $json.new_emails_linked_to_companies + $json.emails_found }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "1a0b2c3d-0006-4000-8000-000000000006",
      "name": "Any New Emails Processed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        380
      ]
    },
    {
      "parameters": {},
      "id": "1a0b2c3d-0007-4000-8000-000000000007",
      "name": "Log Success (Alert / Slack / Discord)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {},
      "id": "1a0b2c3d-0008-4000-8000-000000000008",
      "name": "Idle Run (No New Emails)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1440,
        480
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Hourly Schedule Trigger": {
      "main": [
        [
          {
            "node": "1. Scrape Company Emails",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Trigger (Test Now)": {
      "main": [
        [
          {
            "node": "1. Scrape Company Emails",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "1. Scrape Company Emails": {
      "main": [
        [
          {
            "node": "2. Cross-Reference External Emails",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Cross-Reference External Emails": {
      "main": [
        [
          {
            "node": "Format Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Summary": {
      "main": [
        [
          {
            "node": "Any New Emails Processed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any New Emails Processed?": {
      "main": [
        [
          {
            "node": "Log Success (Alert / Slack / Discord)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Idle Run (No New Emails)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}